rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Happy Beat CL ---
    // Cada usuario autenticado solo puede leer y escribir su propio
    // documento de perfil (identificado por su email). Antes de esta regla,
    // la coleccion /users no tenia ninguna entrada, por lo que Firestore
    // denegaba TODO acceso por defecto (comportamiento seguro pero roto:
    // la app nunca lograba sincronizar datos en la nube, solo localStorage).
    match /users/{userId} {
      // Lectura: cualquier usuario autenticado puede leer el perfil de
      // cualquier otro (necesario para el Feed Social real y el Ranking
      // global de la Comunidad, que muestran actividades de TODOS los
      // usuarios, no solo el propio).
      allow read: if request.auth != null;
      // Escritura: cada usuario solo puede modificar su propio documento.
      allow write: if request.auth != null && request.auth.token.email == userId;
    }

    // Likes reales del Feed Social (Comunidad). Doc con ID autogenerado,
    // campos: { postId, userEmail, createdAt }. Cualquiera autenticado
    // puede leer (para contar likes de todos), pero solo puede crear/borrar
    // SU PROPIO like (no puede dar like en nombre de otro usuario, ni
    // borrar el like de otra persona).
    match /postLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userEmail == request.auth.token.email;
      allow delete: if request.auth != null && resource.data.userEmail == request.auth.token.email;
      allow update: if false;
    }

    // Bitacora de auditoria del Panel de Administracion: registra que
    // administrador hizo que cambio (aprobar identidad, certificar
    // empresa, marcar canje entregado, ascender a otro admin, etc.) y
    // cuando. Solo un usuario cuyo propio documento en /users tenga
    // role == 'admin' puede leer o escribir esta coleccion; nunca se
    // permite editar ni borrar un registro ya creado (integridad del
    // historial).
    match /adminAuditLog/{entryId} {
      allow read, create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
      allow update, delete: if false;
    }

    // --- Reglas preexistentes de otros proyectos (sin modificar) ---
    match /licenses/{licenseKey} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'lastUsedAt']);
      allow create: if true;
    }
    match /enlista/global_state {
      allow read, write: if true;
    }
    match /portfolio/public_data {
      allow read, write: if true;
    }
  }
}
